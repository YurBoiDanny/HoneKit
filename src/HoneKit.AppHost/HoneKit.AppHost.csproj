<Project Sdk="Aspire.AppHost.Sdk/13.6.4">

  <ItemGroup>
    <ProjectReference Include="..\services\Content\HoneKit.Content.csproj" />
    <ProjectReference Include="..\services\Progress\HoneKit.Progress.csproj" />
    <ProjectReference Include="..\services\Roster\HoneKit.Roster.csproj" />
    <ProjectReference Include="..\services\Requirements\HoneKit.Requirements.csproj" />
    <ProjectReference Include="..\services\Recommendations\HoneKit.Recommendations.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Docker" Version="13.6.4" />
    <PackageReference Include="Aspire.Hosting.JavaScript" Version="13.6.4" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AspireUseCliBundle>true</AspireUseCliBundle>
    <!-- WithContainerBuildOptions / ContainerTargetPlatform are marked experimental in Aspire 13.6;
         they are the supported way to stop the compose publisher building linux/amd64 on an arm64 host. -->
    <NoWarn>$(NoWarn);ASPIREPIPELINES003</NoWarn>
    <UserSecretsId>ad84f3bf-cfce-4a45-9ba7-bbe644dc9b03</UserSecretsId>
  </PropertyGroup>

</Project>
