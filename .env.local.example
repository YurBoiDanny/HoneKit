# Copy this file to .env.local, then fill in your key. .env.local is gitignored.
#
# OpenCode Go (OpenAI-compatible models only):
AI__PROVIDER=opencode-go
AI__MODEL=glm-5.3-flash
AI__ENDPOINT=https://opencode.ai/inference/go/openai/v1
AI__APIKEY=

# Other live options:
#
# OpenAI:
# AI__PROVIDER=openai
# AI__MODEL=gpt-5-mini
# AI__ENDPOINT=https://api.openai.com/v1
# AI__APIKEY=
#
# Ollama (free, local; the key is ignored):
# AI__PROVIDER=ollama
# AI__MODEL=llama3.2:3b
# AI__ENDPOINT=http://host.docker.internal:11434/v1
# AI__APIKEY=ollama
#
# Any OpenAI-compatible endpoint (Groq, OpenRouter, ...):
# AI__PROVIDER=openai
# AI__MODEL=llama-3.3-70b-versatile
# AI__ENDPOINT=https://api.groq.com/openai/v1
# AI__APIKEY=
#
# Leave everything commented out for the offline fixture reader:
# AI__PROVIDER=fixture
