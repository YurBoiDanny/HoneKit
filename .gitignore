# ---------------------------------------------------------------------------
# HoneKit — repository ignores
# ---------------------------------------------------------------------------

# Personal learning context — planning workspace, not for commits
/devpost/learner-profile.md

# ---------------------------------------------------------------------------
# Installed agent skills
# ---------------------------------------------------------------------------
# The skill packs are installed from `skills-lock.json` (which IS committed, with
# hashes and source repos). Committing the installed trees would duplicate them,
# and `agent/skills/` is a stale earlier copy of the same thing.
/.agents/
/.opencode/
/.claude/
/agent/

# ---------------------------------------------------------------------------
# Secrets and local configuration
# ---------------------------------------------------------------------------
# Aspire's published .env files are regenerated by `aspire publish`; the
# environment-specific ones can hold resolved secrets, so keep them all local.
.env
.env.*
!/.env.example
aspire-output/.env
aspire-output/.env.*

*.pem
*.key
*.pfx
secrets.json

