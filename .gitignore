# ---------------------------------------------------------------------------
bin/
obj/
[Dd]ebug/
[Rr]elease/
artifacts/
*.user
*.suo
*.userosscache
*.sln.docstates
.vs/
*.binlog
project.lock.json
project.assets.json

# Test output
TestResults/
[Cc]overage/
*.coverage
*.trx
*.testresults

# ---------------------------------------------------------------------------
# Node / Vite / React
# ---------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
.vite/
.cache/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# TS build info
*.tsbuildinfo

# ---------------------------------------------------------------------------
# SQLite data (seeded on first run; never commit a database)
# ---------------------------------------------------------------------------
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
src/services/*/data/

# ---------------------------------------------------------------------------
# Docker / Aspire local state
# ---------------------------------------------------------------------------
.docker/
aspire/
*.dcproj.user

