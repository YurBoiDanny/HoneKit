# Copy to .env for a live model provider. The default, fixture, needs no key and
# replays the committed parse of the sample brief, so the demo works offline.
AI__PROVIDER=fixture
AI__MODEL=gpt-5-mini
AI__ENDPOINT=https://api.openai.com/v1
AI__APIKEY=

# OpenCode Go (optional). Paste the key into .env, not here.
# AI__PROVIDER=opencode-go
# AI__MODEL=glm-5.3-flash
# AI__ENDPOINT=https://opencode.ai/inference/go/openai/v1
# AI__APIKEY=
